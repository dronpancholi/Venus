{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "venus://schemas/base/entity/v1",
  "title": "VenusBaseEntity",
  "description": "Base entity schema inherited by all Venus artifacts, engines, templates, and records.",
  "type": "object",
  "properties": {
    "venus_id": {
      "type": "string",
      "pattern": "^VENUS-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Globally unique Venus identifier."
    },
    "schema": {
      "type": "string",
      "format": "uri",
      "description": "URI reference to the canonical schema this entity conforms to."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Human-readable name." },
        "version": { "type": "string", "pattern": "^V\\d+\\.\\d+$", "description": "Venus OS version (e.g. V0.4)." },
        "layer": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Architectural layer." },
        "type": { "type": "string", "enum": ["part", "engine", "module", "template", "stage", "certificate", "schema", "constitution"], "description": "Artifact type within the Venus taxonomy." },
        "creation_timestamp": { "type": "string", "format": "date-time" },
        "modification_timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "version", "layer", "type", "creation_timestamp"]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "classification": { "type": "string", "enum": ["institutional", "confidential", "public"] },
        "cryptographic_signature": { "type": "string" }
      },
      "required": ["author", "classification"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": { "type": "string" },
          "relationship": { "type": "string", "enum": ["inherits", "depends_on", "references", "validates", "produces"] }
        },
        "required": ["target_id", "relationship"]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["venus_id", "schema", "metadata", "provenance"]
}
