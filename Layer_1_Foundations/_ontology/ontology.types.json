{
  "$schema": "venus://schemas/ontology/v1",
  "title": "Universal Ontology Type System",
  "version": "1.0",
  "root": "Entity",
  "types": [
    { "name": "Entity", "extends": null, "abstract": true, "description": "Root of all Venus types" },

    { "name": "Artifact", "extends": "Entity", "abstract": true, "description": "Any persisted Venus object" },
    { "name": "OperatingSystem", "extends": "Artifact", "description": "V0.X operating system definition" },
    { "name": "Part", "extends": "Artifact", "description": "Knowledge domain component" },
    { "name": "Module", "extends": "Artifact", "description": "Operational unit" },
    { "name": "Engine", "extends": "Artifact", "description": "Executable / verification logic" },
    { "name": "Template", "extends": "Artifact", "abstract": true, "description": "Output artifact blueprint" },
    { "name": "Stage", "extends": "Artifact", "description": "Process stage" },
    { "name": "Certificate", "extends": "Template", "description": "Validation output" },
    { "name": "Schema", "extends": "Artifact", "description": "Type definition" },
    { "name": "Document", "extends": "Artifact", "description": "Generated output" },
    { "name": "Workflow", "extends": "Artifact", "description": "Executable process definition" },
    { "name": "Configuration", "extends": "Artifact", "description": "Runtime configuration" },

    { "name": "Knowledge", "extends": "Entity", "abstract": true, "description": "Institutional knowledge" },
    { "name": "Concept", "extends": "Knowledge", "description": "Abstract idea" },
    { "name": "Principle", "extends": "Knowledge", "description": "Design or operating principle" },
    { "name": "Rule", "extends": "Knowledge", "description": "Formal rule statement" },
    { "name": "Pattern", "extends": "Knowledge", "description": "Reusable pattern" },
    { "name": "Constraint", "extends": "Knowledge", "description": "Boundary condition" },
    { "name": "Metric", "extends": "Knowledge", "description": "Measurable quantity" },
    { "name": "Observation", "extends": "Knowledge", "description": "Recorded observation" },
    { "name": "Taxonomy", "extends": "Knowledge", "description": "Classification system" },

    { "name": "Capability", "extends": "Entity", "abstract": true, "description": "Functional ability" },
    { "name": "Function", "extends": "Capability", "description": "Atomic capability" },
    { "name": "Service", "extends": "Capability", "description": "Composed capability" },
    { "name": "Endpoint", "extends": "Capability", "description": "External interface" },
    { "name": "Protocol", "extends": "Capability", "description": "Communication standard" },

    { "name": "Decision", "extends": "Entity", "abstract": true, "description": "Recorded decision" },
    { "name": "ArchitectureDecision", "extends": "Decision", "description": "Architectural decision" },
    { "name": "TechnicalDecision", "extends": "Decision", "description": "Technical decision" },
    { "name": "ProductDecision", "extends": "Decision", "description": "Product decision" },
    { "name": "StrategicDecision", "extends": "Decision", "description": "Strategic decision" },

    { "name": "Validation", "extends": "Entity", "abstract": true, "description": "Validation artifacts" },
    { "name": "Check", "extends": "Validation", "description": "Single validation rule" },
    { "name": "Gate", "extends": "Validation", "description": "Validation gate" },
    { "name": "Score", "extends": "Validation", "description": "Scoring result" },
    { "name": "Audit", "extends": "Validation", "description": "Audit record" },
    { "name": "Certification", "extends": "Validation", "description": "Certification result" },

    { "name": "Execution", "extends": "Entity", "abstract": true, "description": "Runtime execution" },
    { "name": "Task", "extends": "Execution", "description": "Atomic execution unit" },
    { "name": "Job", "extends": "Execution", "description": "Composed execution" },
    { "name": "Pipeline", "extends": "Execution", "description": "CI/CD pipeline" },
    { "name": "Runtime", "extends": "Execution", "description": "Execution environment" },
    { "name": "WorkflowRun", "extends": "Execution", "description": "Workflow instance" },

    { "name": "Relationship", "extends": "Entity", "abstract": true, "description": "Named typed relationship" },
    { "name": "Dependency", "extends": "Relationship", "description": "Source depends on target" },
    { "name": "Inheritance", "extends": "Relationship", "description": "Source inherits from target" },
    { "name": "Reference", "extends": "Relationship", "description": "Source references target" },
    { "name": "ValidationRel", "extends": "Relationship", "description": "Source validates target" },
    { "name": "Production", "extends": "Relationship", "description": "Source produces target" },
    { "name": "Composition", "extends": "Relationship", "description": "Source contains target" },

    { "name": "Memory", "extends": "Entity", "abstract": true, "description": "Persistent memory" },
    { "name": "SemanticMemory", "extends": "Memory", "description": "Fact / knowledge memory" },
    { "name": "ProceduralMemory", "extends": "Memory", "description": "How-to memory" },
    { "name": "DecisionMemory", "extends": "Memory", "description": "Decision history" },
    { "name": "EvolutionMemory", "extends": "Memory", "description": "Evolution history" },
    { "name": "ResearchMemory", "extends": "Memory", "description": "Research findings" },
    { "name": "ProjectMemory", "extends": "Memory", "description": "Per-project context" },

    { "name": "Agent", "extends": "Entity", "abstract": true, "description": "Autonomous actor" },
    { "name": "Planner", "extends": "Agent", "description": "Planning agent" },
    { "name": "Executor", "extends": "Agent", "description": "Execution agent" },
    { "name": "Validator", "extends": "Agent", "description": "Validation agent" },
    { "name": "Learner", "extends": "Agent", "description": "Learning agent" },
    { "name": "Evolver", "extends": "Agent", "description": "Self-improvement agent" },
    { "name": "Router", "extends": "Agent", "description": "Routing agent" },

    { "name": "Context", "extends": "Entity", "abstract": true, "description": "Execution context" },
    { "name": "SystemContext", "extends": "Context", "description": "System state" },
    { "name": "ExecutionContext", "extends": "Context", "description": "Execution state" },
    { "name": "SecurityContext", "extends": "Context", "description": "Security state" },
    { "name": "BusinessContext", "extends": "Context", "description": "Business state" },

    { "name": "Policy", "extends": "Entity", "abstract": true, "description": "Policy definition" },
    { "name": "SecurityPolicy", "extends": "Policy", "description": "Security rules" },
    { "name": "GovernancePolicy", "extends": "Policy", "description": "Governance rules" },
    { "name": "QualityPolicy", "extends": "Policy", "description": "Quality rules" },
    { "name": "CompliancePolicy", "extends": "Policy", "description": "Compliance rules" },

    { "name": "Event", "extends": "Entity", "abstract": true, "description": "Occurred event" },
    { "name": "Trigger", "extends": "Event", "description": "Event that triggers action" },
    { "name": "Notification", "extends": "Event", "description": "Event notification" },
    { "name": "Error", "extends": "Event", "description": "Error event" },
    { "name": "MetricEvent", "extends": "Event", "description": "Metric event" },

    { "name": "Prompt", "extends": "Entity", "abstract": true, "description": "AI prompt definition" },
    { "name": "SystemPrompt", "extends": "Prompt", "description": "System-level prompt" },
    { "name": "AgentPrompt", "extends": "Prompt", "description": "Agent-level prompt" },
    { "name": "ValidationPrompt", "extends": "Prompt", "description": "Validation prompt" },
    { "name": "GenerationPrompt", "extends": "Prompt", "description": "Generation prompt" },

    { "name": "Goal", "extends": "Entity", "abstract": true, "description": "Objective or target" },
    { "name": "Objective", "extends": "Goal", "description": "High-level goal" },
    { "name": "Requirement", "extends": "Goal", "description": "Formal requirement" },
    { "name": "KeyResult", "extends": "Goal", "description": "Measurable result" },
    { "name": "Milestone", "extends": "Goal", "description": "Temporal marker" },

    { "name": "Interface", "extends": "Entity", "abstract": true, "description": "External interface" },
    { "name": "API", "extends": "Interface", "description": "API definition" },
    { "name": "EventStream", "extends": "Interface", "description": "Event stream" },
    { "name": "Contract", "extends": "Interface", "description": "Interface contract" }
  ]
}
