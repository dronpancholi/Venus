{
  "version": "1.0",
  "description": "Semantic node and edge types for the upgraded knowledge graph",
  "node_types": [
    { "type": "entity", "label": "Entity", "color": "#gray" },
    { "type": "ontology_type", "label": "Ontology Type", "color": "#4A90D9" },
    { "type": "artifact", "label": "Artifact", "color": "#7B68EE" },
    { "type": "concept", "label": "Concept", "color": "#2ECC71" },
    { "type": "capability", "label": "Capability", "color": "#F39C12" },
    { "type": "decision", "label": "Decision", "color": "#E74C3C" },
    { "type": "validation", "label": "Validation", "color": "#1ABC9C" },
    { "type": "execution", "label": "Execution", "color": "#3498DB" },
    { "type": "memory", "label": "Memory", "color": "#9B59B6" },
    { "type": "agent", "label": "Agent", "color": "#E67E22" },
    { "type": "policy", "label": "Policy", "color": "#E74C3C" },
    { "type": "context", "label": "Context", "color": "#95A5A6" },
    { "type": "event", "label": "Event", "color": "#F1C40F" },
    { "type": "prompt", "label": "Prompt", "color": "#1ABC9C" },
    { "type": "goal", "label": "Goal", "color": "#2ECC71" },
    { "type": "interface", "label": "Interface", "color": "#3498DB" },
    { "type": "project", "label": "Project", "color": "#34495E" },
    { "type": "workflow", "label": "Workflow", "color": "#8E44AD" }
  ],
  "edge_types": [
    { "type": "depends_on", "label": "depends on", "semantics": "source requires target" },
    { "type": "inherits", "label": "inherits", "semantics": "source extends target" },
    { "type": "references", "label": "references", "semantics": "source mentions target" },
    { "type": "validates", "label": "validates", "semantics": "source validates target" },
    { "type": "produces", "label": "produces", "semantics": "source generates target" },
    { "type": "contains", "label": "contains", "semantics": "source contains target" },
    { "type": "implements", "label": "implements", "semantics": "source implements target" },
    { "type": "satisfies", "label": "satisfies", "semantics": "source satisfies target" },
    { "type": "triggers", "label": "triggers", "semantics": "source triggers target" },
    { "type": "composes", "label": "composes", "semantics": "source is composed of target" },
    { "type": "governs", "label": "governs", "semantics": "source governs target" },
    { "type": "maps_to", "label": "maps to", "semantics": "source represents concept" },
    { "type": "evolves_to", "label": "evolves to", "semantics": "source becomes target" },
    { "type": "observes", "label": "observes", "semantics": "source observes target" },
    { "type": "learns", "label": "learns", "semantics": "source learns target" },
    { "type": "implements_policy", "label": "implements policy", "semantics": "engine implements policy" },
    { "type": "generates_prompt", "label": "generates prompt", "semantics": "entity generates prompt" },
    { "type": "routes_to", "label": "routes to", "semantics": "agent routes to tool" },
    { "type": "stores_in", "label": "stores in", "semantics": "memory stores knowledge" },
    { "type": "executes_as", "label": "executes as", "semantics": "workflow executes as task" },
    { "type": "consumes_from", "label": "consumes from", "semantics": "project consumes interface" },
    { "type": "feeds_into", "label": "feeds into", "semantics": "event feeds into agent" },
    { "type": "cancels", "label": "cancels", "semantics": "decision cancels previous" },
    { "type": "supersedes", "label": "supersedes", "semantics": "new version supersedes old" }
  ],
  "inference_rules": [
    { "rule": "transitive_dependency", "description": "If A depends_on B and B depends_on C, then A depends_on C" },
    { "rule": "inheritance_chain", "description": "If A inherits B and B inherits C, then A inherits C" },
    { "rule": "composition_transitivity", "description": "If A contains B and B contains C, then A contains C" },
    { "rule": "validation_scope", "description": "If A validates B, A also validates B's sub-entities" },
    { "rule": "producer_downstream", "description": "If A produces B, and B is consumed by C, then A is upstream of C" },
    { "rule": "policy_coverage", "description": "If A governs B, and B depends_on C, then A transitively governs C" }
  ]
}
