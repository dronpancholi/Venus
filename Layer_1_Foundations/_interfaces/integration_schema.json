{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "venus://schemas/integration/v1",
  "title": "IntegrationInterface",
  "description": "Schema for integration interface definitions",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["api", "webhook", "export", "event_stream"]
    },
    "protocol": {
      "type": "string",
      "enum": ["http", "graphql", "grpc", "pubsub", "file"]
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] },
          "request_schema": { "type": "string" },
          "response_schema": { "type": "string" },
          "auth_required": { "type": "boolean" },
          "rate_limit": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["api_key", "oauth2", "jwt", "mutual_tls"] },
        "required_tier": { "type": "string" }
      }
    },
    "consumer": { "type": "string", "description": "Name of consuming project" }
  },
  "required": ["id", "name", "version", "type", "endpoints"]
}
